# Copy to .env and adjust. Nothing here is required except MODEL_PATH pointing at real weights.
MODEL_PATH=models/best.pt          # YOLO11m weights from the GitHub release
CONF_THRESHOLD=0.25
IMGSZ=640
HOST=127.0.0.1                     # 0.0.0.0 to reach the API from a phone on the same network
PORT=5000
FLASK_DEBUG=0
CORS_ORIGINS=*                     # comma-separated origins for the Flutter web build
MAX_UPLOAD_MB=100
RESULTS_DIR=static
LIVE_SOURCE=                       # video file path or camera index (e.g. 0) for /live_stream
DATABASE_URL=                      # e.g. postgresql://postgres:<password>@localhost:5432/landmine_detection
